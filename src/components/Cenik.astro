---
import { cenik, firma } from '../data/site';
---

<section class="section" id="ceny">
	<div class="wrap">
		<div class="sec-head sec-head--tesny">
			<h2 class="h2" data-rvc>{cenik.nadpis}</h2>
			<span class="label">{cenik.poznamka}</span>
		</div>

		<div class="cenik">
			{
				cenik.polozky.map((p) => (
					<article class="cenik__radek" data-rv>
						<span class="cenik__cislo">{p.cislo}</span>
						<h3 class="cenik__nazev">{p.nazev}</h3>
						<p class="cenik__popis">{p.popis}</p>
						<span class:list={['cenik__cena', !p.zvyraznit && 'cenik__cena--tlum']}>
							<span class="only-desktop">{p.cena}</span>
							<span class="only-mobile">{p.cenaMobil}</span>
						</span>
					</article>
				))
			}
		</div>

		<div class="cenik__dale" data-rv>
			<h3 class="cenik__dale-nadpis">{cenik.dale.nadpis}</h3>
			<ul>{cenik.dale.polozky.map((p) => <li>{p}</li>)}</ul>
			<a href={firma.telefonHref} class="cenik__dale-tel">
				{cenik.dale.poznamka} · <strong>{firma.telefonZobrazit}</strong>
			</a>
		</div>
	</div>
</section>

<style>
	.sec-head--tesny {
		align-items: baseline;
		margin-bottom: clamp(24px, 3.5vw, 44px);
	}

	.cenik {
		border-top: 1px solid var(--line);
	}

	.cenik__radek {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.2fr) 200px;
		align-items: baseline;
		border-bottom: 1px solid var(--line);
		transition: background 0.35s;
	}

	.cenik__radek:hover {
		background: var(--srf);
	}

	.cenik__radek > * {
		padding: 26px 0;
	}

	.cenik__cislo {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 12px;
		letter-spacing: 0.16em;
		color: var(--acc);
	}

	.cenik__nazev {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 27px;
		line-height: 1.05;
		text-transform: uppercase;
		color: var(--ink);
		padding-right: 20px;
	}

	.cenik__popis {
		font-size: 15px;
		line-height: 1.6;
		color: var(--mut);
		padding-right: 20px;
	}

	.cenik__cena {
		text-align: right;
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 20px;
		line-height: 1.2;
		color: var(--ink);
		white-space: nowrap;
	}

	.cenik__cena--tlum {
		font-weight: 500;
		font-size: 15px;
		color: var(--mut);
	}

	.cenik__dale {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: 16px 28px;
		margin-top: 28px;
		padding: 22px 24px;
		background: var(--srf);
		border: 1px solid var(--line);
		border-left: 3px solid var(--acc);
	}

	.cenik__dale-nadpis {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
		line-height: 1;
		text-transform: uppercase;
		color: var(--ink);
		white-space: nowrap;
	}

	.cenik__dale ul {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.cenik__dale li {
		font-weight: 500;
		font-size: 14px;
		line-height: 1.3;
		padding: 9px 13px;
		border: 1px solid var(--line);
		background: var(--bg);
		color: var(--ink);
	}

	.cenik__dale-tel {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--mut);
		text-decoration: none;
		white-space: nowrap;
	}

	.cenik__dale-tel strong {
		color: var(--ink);
	}

	.cenik__dale-tel:hover strong {
		color: var(--acc);
	}

	@media (max-width: 1000px) {
		.cenik__radek {
			grid-template-columns: 40px minmax(0, 1fr) auto;
			column-gap: 12px;
		}

		.cenik__cislo {
			grid-row: 1;
		}

		.cenik__nazev {
			grid-row: 1;
			font-size: 22px;
			padding-bottom: 0;
		}

		.cenik__cena {
			grid-row: 1;
			padding-bottom: 0;
		}

		.cenik__popis {
			grid-column: 2 / -1;
			grid-row: 2;
			padding-top: 8px;
			font-size: 14px;
		}

		.cenik__radek > * {
			padding-block: 18px;
		}

		.cenik__dale {
			grid-template-columns: minmax(0, 1fr);
			gap: 14px;
			padding: 18px;
		}
	}

	@media (max-width: 560px) {
		.cenik__nazev {
			font-size: 18px;
		}

		.cenik__cena {
			font-size: 14px;
		}

		.cenik__cena--tlum {
			font-size: 12px;
		}
	}
</style>
