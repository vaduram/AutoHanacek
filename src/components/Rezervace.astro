---
/**
 * Rezervační kalendář SmartServis (PneuB2B) v modálním okně.
 *
 * Widget je cizí bílá aplikace, která uprostřed našeho layoutu ruší. V modálu
 * se objeví až na vyžádání a iframe se načte teprve při prvním otevření —
 * stránka tedy nestahuje nic navíc, dokud o kalendář nikdo nestojí.
 *
 * Pozor: `backUrl` se tu záměrně nepředává. V modálu by tlačítko „Domů"
 * načetlo celý náš web dovnitř iframu; z modálu se odchází křížkem.
 *
 * Nativní vložení komponenty místo iframu je vypnuté (zamrzá na spinneru),
 * viz rezervace.komponenta.povoleno v src/data/site.ts.
 */
import { firma, rezervace } from '../data/site';
---

<section class="section rez" id="rezervace">
	<div class="wrap">
		<div class="sec-head sec-head--tesny">
			<h2 class="h2" data-rvc>Objednat pneuservis</h2>
			<span class="label">Kalendář ukazuje skutečně volná stání</span>
		</div>

		<div class="rez__vyzva" data-rvc>
			<div class="rez__text">
				<p class="rez__perex">
					Vyberete si čas, my připravíme stroj i vaši uskladněnou sadu. Vyvážení
					a kontrola defektů jsou v ceně přezutí.
				</p>
				<p class="rez__tel">
					Servis, klimatizaci, turbo, automat nebo STK objednáme telefonicky —
					<a href={firma.telefonHref}>{firma.telefonZobrazit}</a>, Po–Pá 7:00–16:00.
				</p>
			</div>

			<a href={rezervace.url} class="btn btn--acc rez__cta" data-rezervace-otevrit>
				<span class="sweep" aria-hidden="true"></span>
				<span>Otevřít kalendář</span>
			</a>
		</div>
	</div>
</section>

<dialog class="modal" id="rezervace-modal" aria-label="Online rezervace pneuservisu">
	<div class="modal__hlavicka">
		<div>
			<p class="modal__nadpis">Rezervace pneuservisu</p>
			<p class="modal__zdroj">hanacekauto.rezervaceservisu.cz</p>
		</div>
		<button type="button" class="modal__zavrit" data-rezervace-zavrit aria-label="Zavřít kalendář" autofocus>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>

	<div class="modal__telo">
		<iframe
			title="Online rezervace pneuservisu — Hanáček Auto"
			data-src={rezervace.url}
			referrerpolicy="no-referrer-when-downgrade"></iframe>
	</div>

	<p class="modal__pata">
		Kalendář se nenačetl?
		<a href={rezervace.url} target="_blank" rel="noopener">Otevřete ho v novém okně</a>
		nebo volejte <a href={firma.telefonHref}>{firma.telefonZobrazit}</a>.
	</p>
</dialog>

<style>
	.rez__vyzva {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(24px, 4vw, 48px);
		flex-wrap: wrap;
		border: 1px solid var(--line);
		background: var(--srf);
		padding: clamp(24px, 3.5vw, 40px);
	}

	.rez__perex {
		max-width: 46ch;
		font-size: clamp(16px, 1.4vw, 18px);
		line-height: 1.7;
		color: var(--ink);
	}

	.rez__tel {
		margin-top: 12px;
		max-width: 46ch;
		font-size: 14px;
		line-height: 1.7;
		color: var(--grey);
	}

	.rez__cta {
		flex: none;
		padding: 22px 36px;
	}

	/* ---- modál ---- */

	.modal {
		width: min(1100px, 100vw - 32px);
		max-width: none;
		height: min(880px, 100dvh - 32px);
		padding: 0;
		border: 1px solid var(--line);
		background: var(--bg);
		color: var(--ink);
		display: none;
		flex-direction: column;
		overflow: hidden;
	}

	.modal[open] {
		display: flex;
	}

	.modal::backdrop {
		background: rgba(6, 8, 10, 0.72);
		backdrop-filter: blur(3px);
	}

	.modal__hlavicka {
		flex: none;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		padding: 16px 20px;
		border-bottom: 1px solid var(--line);
		background: var(--srf);
	}

	.modal__nadpis {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 22px;
		line-height: 1;
		text-transform: uppercase;
	}

	.modal__zdroj {
		margin-top: 5px;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--grey);
	}

	.modal__zavrit {
		flex: none;
		width: 44px;
		height: 44px;
		display: grid;
		place-items: center;
		background: none;
		border: 1px solid var(--line);
		color: var(--ink);
		cursor: pointer;
		transition: border-color 0.25s, color 0.25s;
	}

	.modal__zavrit:hover {
		border-color: var(--acc);
		color: var(--acc);
	}

	.modal__telo {
		flex: 1;
		min-height: 0;
		background: #fff;
	}

	.modal__telo iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	.modal__pata {
		flex: none;
		padding: 12px 20px;
		border-top: 1px solid var(--line);
		background: var(--srf);
		font-size: 13px;
		line-height: 1.6;
		color: var(--grey);
	}

	@media (max-width: 760px) {
		.modal {
			width: 100vw;
			height: 100dvh;
			max-height: none;
			border: 0;
		}

		.rez__cta {
			width: 100%;
		}
	}
</style>

<script>
	const modal = document.querySelector<HTMLDialogElement>('#rezervace-modal');

	if (modal) {
		const ram = modal.querySelector<HTMLIFrameElement>('iframe');

		const otevrit = () => {
			// iframe se načte až teď, při prvním otevření
			if (ram && !ram.src) ram.src = ram.dataset.src ?? '';
			if (!modal.open) modal.showModal();
			document.documentElement.style.overflow = 'hidden';
		};

		const zavrit = () => modal.close();

		// Všechna tlačítka „objednat" na stránce míří na #rezervace — bez JS
		// doskáčou na sekci s odkazem, s JS otevřou modál.
		document.querySelectorAll<HTMLAnchorElement>('a[href="#rezervace"], [data-rezervace-otevrit]').forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				otevrit();
			}),
		);

		modal.querySelectorAll('[data-rezervace-zavrit]').forEach((b) => b.addEventListener('click', zavrit));

		// kliknutí mimo obsah zavře
		modal.addEventListener('click', (e) => {
			if (e.target === modal) zavrit();
		});

		// Esc řeší <dialog> sám, jen uklidíme zámek scrollu
		modal.addEventListener('close', () => {
			document.documentElement.style.overflow = '';
		});
	}
</script>
