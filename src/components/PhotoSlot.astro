---
/**
 * Místo pro fotku. Když soubor v public/media/ existuje, vykreslí se.
 * Když ne, zůstane popsaná atrapa s instrukcí, co nafotit — nikdy rozbitý obrázek.
 *
 * Volitelné `video` je smyčka přes fotku jen pro tablet a větší. Na mobilu
 * se nestahuje vůbec a zůstává fotka, stejně jako při omezení pohybu,
 * úsporném režimu dat nebo když prohlížeč přehrání odmítne.
 * Přehrávání řídí skript v Base.astro podle atributu data-smycka.
 */
import fs from 'node:fs';
import path from 'node:path';
import { verejne } from '../lib/cesta';

interface Props {
	soubor: string;
	popis: string;
	video?: string;
	pomer?: string;
	alt?: string;
	class?: string;
	style?: string;
	reveal?: boolean;
	loading?: 'lazy' | 'eager';
}

const {
	soubor,
	popis,
	video,
	pomer,
	alt,
	class: trida,
	style,
	reveal = false,
	loading = 'lazy',
} = Astro.props;

const existuje = (s: string) => fs.existsSync(path.join(process.cwd(), 'public', 'media', s));
const maFotku = existuje(soubor);
const maVideo = video !== undefined && existuje(video);
const styl = [pomer && `aspect-ratio:${pomer}`, style].filter(Boolean).join(';') || undefined;
---

<div class:list={['photo', trida]} style={styl} data-rv={reveal ? '' : undefined}>
	{
		maFotku ? (
			<img src={verejne(`media/${soubor}`)} alt={alt ?? popis} loading={loading} decoding="async" />
		) : (
			<span class="photo__note">FOTO · {popis}</span>
		)
	}
	{
		maVideo && (
			<video
				class="photo__smycka"
				data-smycka={verejne(`media/${video}`)}
				muted
				loop
				playsinline
				disablepictureinpicture
				preload="none"
				aria-hidden="true"
				tabindex="-1"
			/>
		)
	}
</div>
