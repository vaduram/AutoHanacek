---
import { ctaPas, firma } from '../data/site';
---

<section class="ctapas">
	<div class="ctapas__svetlo ctapas__svetlo--modre" aria-hidden="true"></div>
	<div class="ctapas__svetlo ctapas__svetlo--teple" aria-hidden="true"></div>

	<div class="wrap ctapas__obsah">
		<div>
			<h2 class="ctapas__h2" data-rvc>{ctaPas.nadpis[0]}<br />{ctaPas.nadpis[1]}</h2>
			<p class="ctapas__perex" data-rvc>{ctaPas.perex}</p>
		</div>
		<div class="ctapas__akce" data-rvc>
			<a href="#rezervace" class="btn btn--acc">
				<span class="sweep" aria-hidden="true"></span>
				<span>{ctaPas.primarni}</span>
			</a>
			<a href={firma.telefonHref} class="btn btn--ghost">{ctaPas.sekundarni}</a>
		</div>
	</div>
</section>

<style>
	.ctapas {
		position: relative;
		overflow: hidden;
		padding-block: var(--sec);
		background: linear-gradient(120deg, #0e1216 0%, #171d23 55%, #0c0f12 100%);
	}

	.ctapas__svetlo {
		position: absolute;
		top: 0;
		height: 100%;
		transform: skewX(-14deg);
		pointer-events: none;
	}

	.ctapas__svetlo--modre {
		left: -40px;
		width: 520px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(30, 136, 224, 0.16), rgba(255, 255, 255, 0));
	}

	.ctapas__svetlo--teple {
		right: 6%;
		width: 300px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 247, 232, 0.07), rgba(255, 255, 255, 0));
	}

	.ctapas__obsah {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 420px;
		gap: 56px;
		align-items: center;
	}

	.ctapas__h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(38px, 5.4vw, 64px);
		line-height: 0.98;
		text-transform: uppercase;
		color: var(--hero-ink);
	}

	.ctapas__perex {
		margin-top: 22px;
		max-width: 46ch;
		font-size: clamp(16px, 1.4vw, 18px);
		line-height: 1.7;
		color: rgba(239, 233, 223, 0.7);
	}

	.ctapas__akce {
		display: grid;
		gap: 12px;
	}

	.ctapas__akce :global(.btn) {
		padding: 22px;
	}

	@media (max-width: 900px) {
		.ctapas__obsah {
			grid-template-columns: minmax(0, 1fr);
			gap: 32px;
		}
	}
</style>
