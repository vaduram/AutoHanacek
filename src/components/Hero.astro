---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { verejne } from '../lib/cesta';
import { firma, hero, navigace, rezervacePanel, titulek } from '../data/site';

const media = (s: string) => path.join(process.cwd(), 'public', 'media', s);
const maVideo = fs.existsSync(media('hero.mp4'));
const maPoster = fs.existsSync(media('hero-poster.jpg'));
---

<header class="hero" id="prezuti">
	<div class="hero__bg" aria-hidden="true">
		{
			maVideo && (
				<video
					class="hero__video"
					autoplay
					muted
					loop
					playsinline
					preload="metadata"
					poster={maPoster ? verejne('media/hero-poster.jpg') : undefined}
				>
					<source src={verejne('media/hero.mp4')} type="video/mp4" />
				</video>
			)
		}
		{maPoster && !maVideo && <img class="hero__video" src={verejne('media/hero-poster.jpg')} alt="" />}
		<div class="hero__streak hero__streak--wide"></div>
		<div class="hero__streak hero__streak--thin"></div>
		<div class="hero__grain"></div>
		<div class="hero__scrim"></div>
	</div>

	<nav class="nav">
		<a href="#prezuti" class="nav__logo" aria-label={`${firma.znacka} — domů`}>
			<Image src={logo} alt={firma.znacka} height={104} densities={[1, 2]} loading="eager" />
		</a>
		<div class="nav__right">
			<ul class="nav__links">
				{
					navigace.map((p, i) => (
						<li>
							<a href={p.href} class:list={['nav__link', i === 0 && 'is-active']}>
								{p.text}
							</a>
						</li>
					))
				}
			</ul>
			<button type="button" class="nav__theme" data-theme-toggle aria-label="Přepnout světlé a tmavé téma">
				Světlé / tmavé
			</button>
			<a href={firma.telefonHref} class="nav__tel">{firma.telefon}</a>
		</div>
	</nav>

	<div class="hero__body" id="obsah">
		<div class="hero__text">
			<div class="eyebrow" data-rvc>
				<i></i><span>{hero.stitek}</span>
			</div>

			<h1 class="hero__h1">
				{titulek.map((radek) => <span data-rvc>{radek}</span>)}
			</h1>

			<p class="hero__perex" data-rvc>{hero.perex}</p>

			<p class="hero__sezona" data-rvc>
				<span class="hero__sezona-tag">{hero.sezonaStitek}</span>
				<span set:html={hero.sezona} />
			</p>

			<dl class="hero__cisla" data-rvc>
				{
					hero.cisla.map((c) => (
						<div>
							<dd data-count={c.dopocitat ?? undefined}>{c.hodnota}</dd>
							<dt>{c.popis}</dt>
						</div>
					))
				}
			</dl>
		</div>

		<aside class="booking" data-rvc aria-labelledby="booking-nadpis">
			<div class="booking__head">
				<h2 id="booking-nadpis">{rezervacePanel.nadpis}</h2>
				<span class="booking__src">Blok<br />{rezervacePanel.zdroj}</span>
			</div>
			<p class="booking__popis">{rezervacePanel.popis}</p>

			<ol class="booking__kroky">
				<li class="is-on"><span aria-hidden="true">1</span><em>Úkon</em></li>
				<li><span aria-hidden="true">2</span><em>Termín</em></li>
				<li><span aria-hidden="true">3</span><em>Kontakt</em></li>
			</ol>

			<p class="label booking__label">Co kalendář umí objednat</p>
			<ul class="booking__ukony">
				{
					rezervacePanel.ukony.map((u) => (
						<li class:list={[u.vychozi && 'is-on']}>
							{u.nazev}
							{u.doplnek && <em> · {u.doplnek}</em>}
						</li>
					))
				}
			</ul>

			<a href="#rezervace" class="btn btn--acc booking__cta">
				<span class="sweep" aria-hidden="true"></span>
				<span>{rezervacePanel.cta}</span>
			</a>

			<p class="booking__tel" set:html={rezervacePanel.telefonPoznamka} />
		</aside>
	</div>
</header>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		min-height: 840px;
		display: flex;
		flex-direction: column;
		background: linear-gradient(180deg, #0d0f12 0%, #14181d 58%, #0f1215 100%);
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(120% 90% at 78% 12%, rgba(160, 178, 196, 0.34), rgba(13, 15, 18, 0) 58%),
			radial-gradient(90% 70% at 18% 92%, rgba(30, 136, 224, 0.24), rgba(13, 15, 18, 0) 62%),
			linear-gradient(140deg, #2b3238 0%, #191d22 46%, #0c0e11 100%);
	}

	.hero__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.52;
		filter: grayscale(0.45) contrast(1.05) brightness(0.62);
	}

	/* světlo z vrat dílny */
	.hero__streak {
		position: absolute;
		top: 0;
		height: 100%;
		transform: skewX(-14deg);
	}

	.hero__streak--wide {
		right: 8%;
		width: 640px;
		background: linear-gradient(
			90deg,
			rgba(255, 255, 255, 0) 0%,
			rgba(255, 244, 224, 0.07) 42%,
			rgba(255, 244, 224, 0.11) 58%,
			rgba(255, 255, 255, 0) 100%
		);
	}

	.hero__streak--thin {
		right: 34%;
		width: 220px;
		background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 247, 232, 0.08), rgba(255, 255, 255, 0));
	}

	.hero__grain {
		position: absolute;
		inset: 0;
		opacity: 0.055;
		background-image:
			repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.7) 0 1px, rgba(0, 0, 0, 0) 1px 3px),
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.5) 0 1px, rgba(0, 0, 0, 0) 1px 4px);
	}

	.hero__scrim {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, rgba(9, 11, 13, 0.88) 0%, rgba(9, 11, 13, 0.55) 44%, rgba(9, 11, 13, 0.2) 100%);
	}

	/* ---- nav ---- */

	.nav {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
		padding: 26px var(--pad);
		max-width: var(--max);
		margin-inline: auto;
		width: 100%;
	}

	.nav__logo img {
		height: 52px;
		width: auto;
	}

	.nav__right {
		display: flex;
		align-items: center;
		gap: 30px;
	}

	.nav__links {
		display: flex;
		align-items: center;
		gap: 30px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav__link {
		font-family: var(--font-body);
		font-weight: 500;
		font-size: 13px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(239, 233, 223, 0.62);
		text-decoration: none;
		transition: color 0.3s;
	}

	.nav__link:hover,
	.nav__link.is-active {
		color: #efe9df;
	}

	.nav__link.is-active {
		font-weight: 600;
	}

	.nav__theme {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(239, 233, 223, 0.8);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.16);
		backdrop-filter: blur(8px);
		padding: 10px 12px;
		cursor: pointer;
		transition: border-color 0.3s, color 0.3s;
	}

	.nav__theme:hover {
		border-color: var(--acc);
		color: #fff;
	}

	.nav__tel {
		font-weight: 600;
		font-size: 16px;
		color: #efe9df;
		text-decoration: none;
		white-space: nowrap;
	}

	/* ---- hero body ---- */

	.hero__body {
		position: relative;
		flex: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 460px;
		gap: 56px;
		align-items: end;
		padding: 88px var(--pad) 56px;
		max-width: var(--max);
		margin-inline: auto;
		width: 100%;
	}

	.hero__h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(46px, 6.4vw, 92px);
		line-height: 0.92;
		text-transform: uppercase;
		color: var(--hero-ink);
		text-shadow: 0 24px 60px rgba(0, 0, 0, 0.55);
	}

	.hero__h1 span {
		display: block;
	}

	.hero__perex {
		margin-top: 28px;
		max-width: 48ch;
		font-size: clamp(16px, 1.4vw, 19px);
		line-height: 1.65;
		color: var(--hero-mut);
	}

	.hero__sezona {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
		margin-top: 26px;
		padding: 14px 18px;
		border: 1px solid rgba(255, 255, 255, 0.16);
		background: rgba(30, 136, 224, 0.12);
		max-width: 560px;
		font-weight: 500;
		font-size: 15px;
		line-height: 1.5;
		color: rgba(246, 243, 238, 0.9);
	}

	.hero__sezona :global(strong) {
		color: var(--acc);
		font-weight: 700;
	}

	.hero__sezona-tag {
		flex: none;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 10px;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--accink);
		background: var(--acc);
		padding: 7px 9px;
	}

	.hero__cisla {
		display: flex;
		flex-wrap: wrap;
		gap: 40px;
		margin: 44px 0 0;
	}

	.hero__cisla > div + div {
		border-left: 1px solid rgba(255, 255, 255, 0.14);
		padding-left: 40px;
	}

	.hero__cisla dd {
		margin: 0;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(34px, 3.4vw, 46px);
		line-height: 1;
		color: var(--hero-ink);
	}

	.hero__cisla dt {
		font-weight: 500;
		font-size: 11px;
		line-height: 1.4;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--hero-dim);
		margin-top: 6px;
	}

	/* ---- rezervační panel ---- */

	.booking {
		background: rgba(255, 255, 255, 0.055);
		border: 1px solid rgba(255, 255, 255, 0.14);
		backdrop-filter: blur(18px);
		box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5);
		padding: 30px 30px 32px;
	}

	.booking__head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		margin-bottom: 6px;
	}

	.booking__head h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 27px;
		line-height: 1;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--hero-ink);
	}

	.booking__src {
		font-family: var(--font-mono);
		font-size: 9px;
		line-height: 1.4;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--acc);
		text-align: right;
		flex: none;
	}

	.booking__popis {
		margin-bottom: 22px;
		font-size: 13px;
		line-height: 1.55;
		color: rgba(239, 233, 223, 0.6);
	}

	.booking__kroky {
		display: flex;
		align-items: center;
		gap: 9px;
		list-style: none;
		margin: 0 0 22px;
		padding: 0;
	}

	.booking__kroky li {
		display: contents;
	}

	/* popisky kroků nese jen odečítač obrazovky, v návrhu jsou jen kolečka */
	.booking__kroky em {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.booking__kroky li span {
		flex: none;
		width: 24px;
		height: 24px;
		border-radius: 50%;
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.25);
		color: rgba(239, 233, 223, 0.6);
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 11px;
	}

	.booking__kroky li.is-on span {
		background: var(--acc);
		border-color: var(--acc);
		color: var(--accink);
	}

	.booking__kroky li:not(:last-child)::after {
		content: '';
		flex: 1;
		height: 1px;
		background: rgba(255, 255, 255, 0.16);
	}

	.booking__kroky li.is-on:not(:last-child)::after {
		background: var(--acc);
	}

	.booking__label {
		color: rgba(239, 233, 223, 0.5);
		margin-bottom: 9px;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 10px;
		letter-spacing: 0.18em;
	}

	.booking__ukony {
		display: flex;
		flex-wrap: wrap;
		gap: 7px;
		list-style: none;
		margin: 0 0 22px;
		padding: 0;
	}

	.booking__ukony li {
		font-weight: 500;
		font-size: 12px;
		line-height: 1.3;
		padding: 11px 13px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: rgba(239, 233, 223, 0.7);
	}

	.booking__ukony li.is-on {
		background: var(--acc);
		border-color: var(--acc);
		color: var(--accink);
		font-weight: 600;
	}

	.booking__ukony em {
		font-style: normal;
		opacity: 0.75;
	}

	.booking__cta {
		width: 100%;
		padding: 18px;
		font-size: 13px;
	}

	.booking__tel {
		margin-top: 14px;
		font-size: 12px;
		line-height: 1.55;
		color: rgba(239, 233, 223, 0.5);
	}

	.booking__tel :global(a) {
		color: var(--hero-ink);
		font-weight: 600;
	}

	/* ---- responzivita ---- */

	@media (max-width: 1080px) {
		.hero {
			min-height: 0;
		}

		.hero__body {
			grid-template-columns: minmax(0, 1fr);
			gap: 36px;
			padding-top: 56px;
		}

		.booking {
			max-width: 520px;
		}
	}

	@media (max-width: 860px) {
		.nav__links,
		.nav__tel {
			display: none;
		}

		.nav__logo img {
			height: 38px;
		}
	}

	@media (max-width: 560px) {
		.hero__cisla {
			gap: 22px;
		}

		.hero__cisla > div + div {
			padding-left: 22px;
		}

		.hero__cisla dt {
			font-size: 10px;
			letter-spacing: 0.12em;
		}

		.booking {
			padding: 22px 20px 24px;
		}

		.hero__body {
			padding-bottom: 40px;
		}
	}
</style>
