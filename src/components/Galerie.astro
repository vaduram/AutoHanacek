---
import PhotoSlot from './PhotoSlot.astro';
import { galerie } from '../data/site';
---

<section class="section galerie-sec">
	<div class="wrap">
		<div class="sec-head">
			<h2 class="h2" data-rvc>{galerie.nadpis[0]}<br />{galerie.nadpis[1]}</h2>
			<p class="sec-perex" data-rvc>{galerie.perex}</p>
		</div>

		<div class="galerie">
			{
				galerie.fotky.map((f) => (
					<PhotoSlot
						soubor={f.soubor}
						popis={f.popis}
						alt={`Dílna Hanáček Auto — ${f.popis}`}
						class="galerie__item"
						reveal
						style={`--c:${f.sloupce};--r:${f.radky};--cm:${f.mobil}`}
					/>
				))
			}
		</div>
	</div>
</section>

<style>
	.galerie {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-auto-rows: 190px;
		gap: 16px;
	}

	.galerie :global(.galerie__item) {
		grid-column: span var(--c, 2);
		grid-row: span var(--r, 1);
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.galerie :global(.galerie__item:hover) {
		transform: scale(1.015);
	}

	@media (max-width: 1000px) {
		.galerie {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			grid-auto-rows: 160px;
		}

		.galerie :global(.galerie__item) {
			grid-column: span min(var(--c, 2), 4);
		}
	}

	@media (max-width: 620px) {
		.galerie {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: 130px;
			gap: 10px;
		}

		.galerie :global(.galerie__item) {
			grid-column: span var(--cm, 1);
			grid-row: span 1;
		}
	}
</style>
