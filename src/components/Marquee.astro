---
import { bezici } from '../data/site';
---

<div class="marquee" aria-hidden="true">
	<div class="marquee__track">
		{
			[0, 1].map(() => (
				<div class="marquee__row">
					{bezici.map((p) => (
						<>
							<span>{p}</span>
							<span>·</span>
						</>
					))}
				</div>
			))
		}
	</div>
</div>

<style>
	.marquee {
		overflow: hidden;
		border-bottom: 1px solid var(--line);
		background: var(--srf);
		padding: 18px 0;
	}

	.marquee__track {
		display: flex;
		width: max-content;
		animation: marquee 42s linear infinite;
	}

	.marquee__row {
		display: flex;
		gap: 56px;
		padding-right: 56px;
		font-weight: 500;
		font-size: 13px;
		line-height: 1;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--grey);
		white-space: nowrap;
	}

	.marquee:hover .marquee__track {
		animation-play-state: paused;
	}

	@media (max-width: 760px) {
		.marquee {
			padding: 13px 0;
		}

		.marquee__row {
			gap: 34px;
			padding-right: 34px;
			font-size: 11px;
			letter-spacing: 0.2em;
		}

		.marquee__track {
			animation-duration: 30s;
		}
	}
</style>
