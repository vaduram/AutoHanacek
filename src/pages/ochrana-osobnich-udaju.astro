---
import Base from '../layouts/Base.astro';
import Lista from '../components/Lista.astro';
import Paticka from '../components/Paticka.astro';
import { firma, ochranaUdaju } from '../data/site';
---

<Base titulek={`${ochranaUdaju.titulek} — ${firma.znacka}`} popis={ochranaUdaju.perex}>
	<Lista />
	<main class="section">
		<article class="wrap ou">
			<div class="eyebrow">
				<i></i><span>Upraveno {ochranaUdaju.upraveno}</span>
			</div>
			<h1 class="h2 ou__h1">{ochranaUdaju.titulek}</h1>
			<p class="ou__perex">{ochranaUdaju.perex}</p>

			{
				ochranaUdaju.sekce.map((s) => (
					<section class="ou__sekce">
						<h2 class="ou__nadpis">{s.nadpis}</h2>
						{s.odstavce?.map((o) => <p set:html={o} />)}
						{s.body && <ul>{s.body.map((b) => <li set:html={b} />)}</ul>}
					</section>
				))
			}
		</article>
	</main>

	<Paticka />
</Base>

<style>
	.ou {
		max-width: calc(72ch + 2 * var(--pad));
	}

	.ou__h1 {
		margin-top: 18px;
	}

	.ou__perex {
		margin-top: 20px;
		font-size: clamp(16px, 1.4vw, 18px);
		line-height: 1.65;
		color: var(--ink);
	}

	.ou__sekce {
		margin-top: 40px;
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}

	.ou__nadpis {
		margin: 0 0 14px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: clamp(22px, 2.4vw, 28px);
		line-height: 1.1;
		text-transform: uppercase;
	}

	.ou__sekce p,
	.ou__sekce li {
		font-size: 16px;
		line-height: 1.7;
		color: var(--mut);
	}

	.ou__sekce p + p {
		margin-top: 12px;
	}

	.ou__sekce ul {
		margin: 0;
		padding-left: 20px;
	}

	.ou__sekce li + li {
		margin-top: 8px;
	}

	.ou__sekce :global(a) {
		color: var(--acc);
	}
</style>
